{
  "manifest_version": 3,
  "name": "回关检查 · X 本地工具",
  "version": "2.3.0",
  "minimum_chrome_version": "111",
  "description": "打开项目本地存档名单，自动选择最新存档并支持手动切换；服务未启动时显示指引。保留手动导入与可选在线扫描。",
  "host_permissions": [
    "https://x.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "打开项目存档未回关名单"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
