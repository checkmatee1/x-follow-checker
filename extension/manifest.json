{
  "manifest_version": 3,
  "name": "回关检查 · X 本地工具",
  "version": "2.0.0",
  "minimum_chrome_version": "111",
  "description": "自动识别当前 X 登录账号，在本机筛选未回关名单。无需填写用户名或重新登录。",
  "host_permissions": ["https://x.com/*"],
  "action": { "default_title": "检查当前 X 账号的未回关名单" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["shared.js", "content.js"], "run_at": "document_start", "world": "ISOLATED" },
    { "matches": ["https://x.com/*"], "js": ["page-bridge.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
